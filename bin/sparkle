#!/usr/bin/env bash
# sparkle — operate CLI for sparkle.lab980.com (Sparkle Butt).
#
# The site is a single static index.html served straight by nginx: no app
# process, no local port, no pm2, no build step. This script is the whole
# lifecycle:
#
#   sparkle setup      one-time on the droplet: DNS A record (doctl), static
#                      nginx vhost from deploy/nginx.conf.template, TLS via
#                      certbot, /usr/local/bin symlink. Idempotent.
#   sparkle deploy     sync this checkout to origin/main (fetch + hard reset)
#   sparkle status     HEAD, live-site probe, cert days remaining
#   sparkle art-setup  enable the shared art store (/art/): WebDAV + JSON
#                      autoindex, open to anyone with the link, files in
#                      /var/lib/sparkle-art — still no app process. Idempotent.
#
# Env overrides:
#   SPARKLE_FQDN     default sparkle.lab980.com
#   SPARKLE_BRANCH   default main
#
# The web root is wherever this script's repo checkout lives (normally
# /var/www/sparkle) — derived from the script's own path, so the
# /usr/local/bin symlink resolves back here.
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
FQDN="${SPARKLE_FQDN:-sparkle.lab980.com}"
BRANCH="${SPARKLE_BRANCH:-main}"
DOMAIN="${FQDN#*.}"
STUB="${FQDN%%.*}"

c_blue=$'\033[1;34m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
sparkle — operate sparkle.lab980.com (static single-file game, nginx-only).

Usage:
  sparkle setup [--no-dns] [--no-tls] [--ip IP]   provision DNS + vhost + TLS
  sparkle deploy                                  sync checkout to origin/main
  sparkle status                                  HEAD + live probe + cert
  sparkle art-setup                               enable shared art store (/art/)

Env: SPARKLE_FQDN (default sparkle.lab980.com), SPARKLE_BRANCH (default main).
USAGE
}

ART_DIR="/var/lib/sparkle-art"
ART_SNIPPET="/etc/nginx/snippets/sparkle-art.conf"

cmd_setup() {
  local DO_DNS=1 DO_TLS=1 IP=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-dns) DO_DNS=0; shift;;
      --no-tls) DO_TLS=0; shift;;
      --ip)     IP="$2"; shift 2;;
      *) die "unknown setup option: $1";;
    esac
  done
  [ "$(id -u)" -eq 0 ] || die "setup must run as root."
  [ -f "$ROOT/index.html" ] || die "no index.html in $ROOT — is this the sparkle-butt checkout?"

  log "Setting up $FQDN  (web root: $ROOT)"

  if { [ "$DO_DNS" -eq 1 ] || [ "$DO_TLS" -eq 1 ]; } && [ -z "$IP" ]; then
    IP="$(curl -s --max-time 5 http://169.254.169.254/metadata/v1/interfaces/public/0/ipv4/address || true)"
  fi

  # ---- DNS A record via doctl (same shape as provision-site) ----
  if [ "$DO_DNS" -eq 1 ]; then
    command -v doctl >/dev/null || die "doctl not found; install it or pass --no-dns and create the record yourself."
    [ -n "$IP" ] || die "couldn't determine droplet IP for DNS; pass --ip."
    local existing
    existing="$(doctl compute domain records list "$DOMAIN" --no-header --format Type,Name,Data 2>/dev/null \
                | awk -v n="$STUB" '$1=="A" && $2==n {print $3}' | head -1)"
    if [ -n "$existing" ]; then
      log "DNS: A $FQDN -> $existing already exists (leaving as-is)"
    else
      log "DNS: creating A $FQDN -> $IP (ttl 300)"
      doctl compute domain records create "$DOMAIN" \
        --record-type A --record-name "$STUB" --record-data "$IP" --record-ttl 300 >/dev/null
    fi
  fi

  # ---- shared security headers snippet (seed if this is a fresh box) ----
  local snippet="/etc/nginx/snippets/lab980-security-headers.conf"
  if [ ! -f "$snippet" ]; then
    mkdir -p /etc/nginx/snippets
    cat > "$snippet" <<'EOF'
# lab980 shared security headers — managed by fix-security-headers.
# Included at server{} level by every :443 vhost. Do not add a CSP here:
# that one is per-site (snippets/lab980-csp-self.conf, opt-in).
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
EOF
    log "nginx: seeded $snippet"
  fi

  # ---- static vhost from template ----
  # If the vhost already exists, leave it alone: certbot rewrites it when TLS
  # is added, and regenerating from the template would clobber that.
  local conf="/etc/nginx/sites-available/$FQDN"
  if [ -f "$conf" ]; then
    log "nginx: $conf already exists (leaving as-is)"
  else
    log "nginx: writing $conf (static root: $ROOT)"
    sed -e "s|__FQDN__|$FQDN|g" -e "s|__ROOT__|$ROOT|g" \
      "$ROOT/deploy/nginx.conf.template" > "$conf"
  fi
  ln -sf "$conf" "/etc/nginx/sites-enabled/$FQDN"
  nginx -t && systemctl reload nginx
  log "nginx: enabled and reloaded"

  # ---- TLS via certbot ----
  if [ "$DO_TLS" -eq 1 ]; then
    if ! command -v certbot >/dev/null; then
      warn "certbot not found; skipping TLS. Later: certbot --nginx -d $FQDN --redirect -n"
    else
      if [ -n "$IP" ]; then
        log "waiting for $FQDN to resolve to $IP (up to ~5 min) ..."
        local ok=0 got=""
        for _ in $(seq 1 30); do
          if command -v dig >/dev/null; then got="$(dig +short "$FQDN" | tail -1)"
          else got="$(getent hosts "$FQDN" | awk '{print $1}' | head -1)"; fi
          [ "$got" = "$IP" ] && { ok=1; break; }
          sleep 10
        done
        if [ "$ok" -ne 1 ]; then
          warn "$FQDN not resolving to $IP yet (DNS still propagating)."
          warn "Re-run TLS later:  certbot --nginx -d $FQDN --redirect -n"
          DO_TLS=0
        fi
      fi
      if [ "$DO_TLS" -eq 1 ]; then
        log "TLS: issuing cert for $FQDN"
        certbot --nginx -d "$FQDN" --redirect -n
      fi
    fi
  fi

  # ---- operate-CLI symlink (per lab980 convention) ----
  if [ "$SELF" != "/usr/local/bin/sparkle" ]; then
    ln -sf "$ROOT/bin/sparkle" /usr/local/bin/sparkle
    log "symlinked /usr/local/bin/sparkle -> $ROOT/bin/sparkle"
  fi

  log "Done. Site: https://$FQDN/"
}

# Wrapped so the whole function is parsed before `git reset` can rewrite this
# script mid-run (same trick as lab980's update.sh).
cmd_deploy() {
  cd "$ROOT"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$ROOT is not a git clone."
  log "Syncing $ROOT to origin/$BRANCH"
  local before after
  before="$(git rev-parse --short HEAD)"
  git fetch --quiet origin "$BRANCH"
  git reset --hard --quiet "origin/$BRANCH"
  after="$(git rev-parse --short HEAD)"
  if [ "$before" = "$after" ]; then
    log "already current ($after)"
  else
    log "$before -> $after"
    git --no-pager log --oneline "$before..$after"
  fi
  # Stamp the deployed commit into the game (repo says BUILD = 'dev'). The
  # game shows it on the title screen and open tabs poll it to self-update,
  # so stale caches can't hide a deploy. Dirties the checkout on purpose;
  # the next deploy's reset --hard wipes and re-stamps it.
  # (anchored to the declaration line — an unanchored pattern would also hit
  # the update-checker's own regex literal further down and corrupt it)
  sed -i "s/^  const BUILD = '[^']*';/  const BUILD = '$after';/" index.html
  log "stamped build $after into index.html"
  log "Done. (Static files serve straight from disk — no reload needed;"
  log " index.html is sent with Cache-Control: no-cache, and open tabs"
  log " see the new build stamp and offer/auto-apply a refresh.)"
}

# Shared art store: the sprite manager (tools/sprite-manager.html) talks to
# /art/ with plain fetch — PUT/DELETE via nginx's WebDAV module, listings via
# autoindex_format json. Files live outside the checkout so `sparkle deploy`
# (hard reset) never touches them. No auth: anyone with the link can view and
# upload — acceptable for an unlisted art scratchpad; the store is a single
# confined directory with an 8 MB body cap.
cmd_art_setup() {
  [ "$(id -u)" -eq 0 ] || die "art-setup must run as root."
  nginx -V 2>&1 | grep -q 'http_dav_module' \
    || die "this nginx lacks http_dav_module (need PUT/DELETE for /art/). Install Ubuntu's nginx-full."

  log "art store: $ART_DIR (frames/)"
  mkdir -p "$ART_DIR/frames"
  chown -R www-data:www-data "$ART_DIR"
  chmod 750 "$ART_DIR"

  # The location lives in a snippet so it can be injected into the live vhost
  # (which certbot owns after TLS) without regenerating it from the template.
  log "nginx: writing $ART_SNIPPET"
  cat > "$ART_SNIPPET" <<EOF
# Shared art store for tools/sprite-manager.html — managed by \`sparkle art-setup\`.
# nginx-only backend: WebDAV writes + JSON directory listings, no auth (link
# access). Uploads live outside the git checkout so deploys never touch them.
location ^~ /art/ {
    alias $ART_DIR/;
    autoindex on;
    autoindex_format json;
    dav_methods PUT DELETE;
    create_full_put_path on;
    client_max_body_size 8m;
    include snippets/lab980-security-headers.conf;
    add_header Cache-Control "no-cache" always;
}
EOF

  local conf="/etc/nginx/sites-available/$FQDN"
  [ -f "$conf" ] || die "vhost $conf not found — run 'sparkle setup' first."
  if grep -q 'snippets/sparkle-art.conf' "$conf"; then
    log "nginx: $conf already includes the art snippet"
  else
    # After every server_name line, so both the :80 and certbot's :443 block
    # get it. certbot only rewrites its own cert lines on renew, so this edit
    # survives.
    sed -i "s|^\([[:space:]]*\)server_name $FQDN;|&\n\1include snippets/sparkle-art.conf;|" "$conf"
    grep -q 'snippets/sparkle-art.conf' "$conf" \
      || die "couldn't inject the include into $conf — add 'include snippets/sparkle-art.conf;' to its server block(s) by hand."
    log "nginx: injected art snippet include into $conf"
  fi
  nginx -t && systemctl reload nginx
  log "Done. Store: https://$FQDN/art/  Tool: https://$FQDN/tools/sprite-manager.html"
}

cmd_status() {
  cd "$ROOT"
  printf 'checkout:  %s  %s\n' "$(git rev-parse --short HEAD)" "$(git log -1 --format=%s)"
  local page code build
  page="$(curl -s --max-time 10 -w '\n%{http_code}' "https://$FQDN/" || true)"
  code="$(printf '%s' "$page" | tail -1)"
  build="$(printf '%s' "$page" | grep -o "const BUILD = '[^']*'" | cut -d"'" -f2)"
  printf 'live:      https://%s/  ->  HTTP %s  (build %s)\n' \
    "$FQDN" "${code:-unreachable}" "${build:-unknown}"
  local art
  art="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$FQDN/art/frames/" || true)"
  case "$art" in
    200) printf 'art store: enabled\n';;
    404) printf 'art store: not enabled (run: sparkle art-setup)\n';;
    *)   printf 'art store: /art/frames/ -> HTTP %s\n' "${art:-unreachable}";;
  esac
  local pem="/etc/letsencrypt/live/$FQDN/cert.pem"
  if [ -r "$pem" ]; then
    local end days
    end="$(openssl x509 -enddate -noout -in "$pem" | cut -d= -f2)"
    days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    printf 'cert:      %s days remaining (expires %s)\n' "$days" "$end"
  else
    printf 'cert:      (run as root to read expiry)\n'
  fi
}

case "${1:-}" in
  setup)     shift; cmd_setup "$@";;
  deploy)    shift; cmd_deploy "$@";;
  status)    shift; cmd_status "$@";;
  art-setup) shift; cmd_art_setup "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (see --help)";;
esac
